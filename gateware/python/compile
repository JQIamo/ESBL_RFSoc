#!/bin/bash
python esbl_parallel_with_PDH.py 

# Renaming init files to mem files in code
awk '{gsub(/init"/, "mem\"")} 1' phase_generator_parallel.v > tmp
mv -f tmp phase_generator_parallel.v
mv phase_generator_parallel.v ../hdl/
mv *.init ../hdl/lut

# Change all init file extensions to mem
for f in ../hdl/lut/*.init; do mv -- "$f" "${f%.init}.mem"; done